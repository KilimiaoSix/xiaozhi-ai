// 编译期默认 WiFi（可选）。
//
// 把本文件复制成同目录的 wifi_credentials.h 并填上真实凭据，固件首次开机会把它
// 播种进 SsidManager，省掉一次 AP 配网。wifi_credentials.h 已被 .gitignore 排除，
// 密码不会进提交历史；没有这个文件时 wifi_board.cc 整段不参与编译，行为回到
// 原本的"没配过 WiFi 就进 AP 配网模式"。
//
//   cp main/wifi_credentials.h.example main/wifi_credentials.h
//
// 留空字符串等于不启用。SSID 上限 32 字节、密码上限 64 字节（见 ssid_manager.cc）。

#ifndef _WIFI_CREDENTIALS_H_
#define _WIFI_CREDENTIALS_H_

#define DEFAULT_WIFI_SSID     ""
#define DEFAULT_WIFI_PASSWORD ""

#endif // _WIFI_CREDENTIALS_H_
