{
  "name": "xiaofei-deskbot",
  "productName": "小智桌面机器人",
  "version": "0.1.0",
  "description": "小智桌面机器人的 Electron 控制台",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "dev": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-forge start",
